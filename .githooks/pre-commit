#!/usr/bin/env bash
# Blocks a commit that would put a secret into this repo.
#
# Installed from vault/99-Meta/install-hooks.sh, which is the only thing that
# should edit this file or tools/scan-secrets.py. The vault copy is canonical.
#
# WHY THIS EXISTS, 20 Nov 2026. The vault has had this gate since October and
# the six code repos never did - including pupcup-site and ratedarf-site,
# where GitHub Pages serves the repo root, so a merge is a publish and a
# mistake is downloadable the moment it lands. The audit that found this is
# 03-Projects/vilmartian/specs/security-audit-2026-11-20.md.
#
# Bypass only with a reason you can defend: git commit --no-verify
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 not found — NOT a pass, the check did not run" >&2
  exit 1
fi
if ! python3 -I "$ROOT/tools/scan-secrets.py"; then
  echo
  echo "✗ COMMIT BLOCKED — secret-shaped strings in the staged change."
  echo "  Remove them from the file, not just from the commit."
  echo "  If it is a false positive, tighten the pattern in"
  echo "  vault/99-Meta/scan-secrets-code.py and re-run install-hooks.sh."
  echo "  There is no file allowlist by design: the moment a path can be"
  echo "  excused, the excuse becomes the hiding place."
  echo
  echo "  Git history is permanent. A secret committed once stays"
  echo "  recoverable after you delete it — rotate it, do not just edit it."
  exit 1
fi
exit 0
